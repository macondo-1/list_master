def submit_task(label, func, *args, **kwargs):
    """
    Submits `func` to the background thread pool.

    ThreadPoolExecutor swallows exceptions raised inside submitted tasks --
    they sit on the Future object and are never printed unless something
    calls .result()/.exception() on it. Nobody was doing that here, which is
    why failing tasks looked like they "silently failed". This wrapper
    attaches a done-callback that always prints success or failure (with
    the full traceback) once the task finishes.
    """
    global task_counter
    with lock:
        current_task = task_counter
        task_counter += 1

    print(f"[✓] Task {current_task} - {label} submitted.")

    future = executor.submit(func, *args, **kwargs)

    def _on_done(fut, task_number=current_task, task_label=label):
        exc = fut.exception()
        if exc is not None:
            print(f"\n[✗] Task {task_number} - {task_label} FAILED: {exc}")
            traceback.print_exception(type(exc), exc, exc.__traceback__)
        else:
            print(f"\n[✓] Task {task_number} - {task_label} completed successfully.")

    future.add_done_callback(_on_done)
    return future

